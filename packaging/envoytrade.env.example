# ==============================================================================
# EnvoyTrade Production Configuration (Single Binary)
# ==============================================================================

# Option A: Linux Native Host / VPS (Fastest: Unix Domain Socket, sub-0.15ms latency)
DATABASE_URL=postgres://envoytrade:envoytrade@/envoytrade?host=/var/run/postgresql&pool_min_conns=5&pool_max_conns=25

# Option B: macOS Native Host (Fastest: Unix Domain Socket at /tmp, sub-0.15ms latency)
# DATABASE_URL=postgres://envoytrade:envoytrade@/envoytrade?host=/tmp&pool_min_conns=5&pool_max_conns=25

# Option C: Fallback TCP (Local container or remote host)
# DATABASE_URL=postgres://envoytrade:envoytrade@localhost:5432/envoytrade?sslmode=disable&pool_min_conns=5&pool_max_conns=25

# HTTP Port
PORT=8080

# 32-byte (or strong passphrase) AES-256 encryption key used for sensitive secrets (required)
ENCRYPTION_KEY=

# Logging
LOG_FILE=/var/log/envoytrade/app.log
LOG_LEVEL=info
LOG_FORMAT=json
LOG_TO_STDOUT=false
