# ==============================================================================
# EnvoyTrade Production Configuration (Single Binary)
# ==============================================================================

# Option A: Linux Native Host / VPS (Fastest: Unix Domain Socket, sub-0.15ms latency)
DATABASE_URL=postgres://envoytrade:envoytrade@/envoytrade?host=/var/run/postgresql&pool_min_conns=5&pool_max_conns=25

# Option B: Fallback / macOS TCP (Local container or Homebrew Postgres)
# DATABASE_URL=postgres://envoytrade:envoytrade@localhost:5432/envoytrade?sslmode=disable&pool_min_conns=5&pool_max_conns=25

# HTTP Port
PORT=8080

# Logging
LOG_FILE=/var/log/envoytrade/app.log
LOG_LEVEL=info
LOG_FORMAT=json
LOG_TO_STDOUT=false
