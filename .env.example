# EnvoyTrade Environment Configuration Template
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Database connection URL (PostgreSQL)
DATABASE_URL=postgres://envoytrade:envoytrade@localhost:5434/envoytrade?sslmode=disable

# Application HTTP port
PORT=8080

# 32-byte (or any strong passphrase) AES-256 encryption key used to encrypt broker passwords & TOTP secrets.
# REQUIRED for running the backend.
ENCRYPTION_KEY=

# Logging options
LOG_LEVEL=info
LOG_FORMAT=text
LOG_TO_STDOUT=true
